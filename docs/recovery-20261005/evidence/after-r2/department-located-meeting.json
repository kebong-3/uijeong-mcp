          "question": {
            "turn_index": 269,
            "label": "김은수 위원",
            "role": "member",
            "text": "지금 “빌라가꿈관리소 확대 추진” 그러면 빌라에 관리소가 없고 관리소장이 없으면 초소를 만들어서 소장을 수원시에서 뽑는다는 소리입니까?",
            "agenda": 2,
            "act": "question",
            "citation": {
              "record_id": "rec_a48f481202216889d548df72",
              "docid": "CLIKC2479358086714915",
              "turn_index": 269,
              "source_url": null,
              "body_url": "https://clik.nanet.go.kr/openapi/minutes.do",
              "source_kind": "OFFICIAL_FETCHED",
              "body_sha256": "60a82b710497e196baa2c54ff7da894e9f5b04fdcc4ab00f6cbd63924f88d3fa",
              "turn_sha256": "62dbd65fe2d1821232b8929efd05792858b5be9636c0812d07b48947f001b2ce",
              "locator": "parsed_turn",
              "char_start": 0,
              "char_end": 75,
              "fiscal_year": null,
              "source_url_status": "NOT_AVAILABLE",
              "body_url_status": "FETCHED",
              "citation_url": null,
              "citation_markdown": null,
              "citation_status": null,
              "citation_kind": null
            },
            "speaker": "김은수 위원"
          },
          "answers": [
            {
              "turn_index": 270,
              "label": "건축과장 이순헌",
              "role": "executive",
              "text": "말씀하신 것처럼 취지는 대규모 아파트단지 같은 경우는 관리사무소나 관리하는 분들이 계시는데 각자 한 동, 한 동의 소규모 빌라단지들은 공동으로 관리하시는 분들이 없다 보니까, 예를 들면 쓰레기를 수거하면 잔재물이 남는데 이런 부분에 대해서 정리가 안 되다 보니까 환경적으로 지저분하고 그래서 그런 부분은 한 개의 섹터를 정해 관리소장을 시에서 뽑아서 그분이 그런 잔재물을 정리해 주고 공용시설물이 파손되면 수리도 해주고 그런 것을 하는 사항입니다.",
              "agenda": 2,
              "act": "answer_candidate",
              "citation": {
                "record_id": "rec_a48f481202216889d548df72",
                "docid": "CLIKC2479358086714915",
