# Configuration reference. This server does not automatically load .env files.
CLIK_API_KEY=
# work = 14 tools: recommended for council preparation (includes department-entry tools)
# core = 5 entry tools, lite = 22 tools, full = 34 tools
UIJEONG_PROFILE=work
# CLIK_DAILY_LIMIT=1000

# Response budget: a tool result is consumed inside a model context window.
# Structured results are reduced to fit; omissions are reported, never silent.
# UIJEONG_MAX_RESPONSE_CHARS=30000
# Below this size the text block repeats the JSON for older clients.
# UIJEONG_TEXT_JSON_MAX_CHARS=8000

# Evidence snapshot store (paging without re-querying upstream).
# UIJEONG_STATE_DB=/absolute/persistent/path/uijeong.sqlite3
# UIJEONG_SNAPSHOT_MAX_ENTRIES=2000
# UIJEONG_SNAPSHOT_MAX_TOTAL_BYTES=268435456

# COUNCIL_LOCAL_DIR=/absolute/path/minutes_archive
# SEOGU_DELAY_SEC=1.5

# Remote HTTP only:
# UIJEONG_BIND_HOST=0.0.0.0
# UIJEONG_ALLOWED_HOSTS=your-service.onrender.com
# UIJEONG_BEARER_TOKEN=generate-a-long-random-secret-outside-source-control
# UIJEONG_ALLOWED_ORIGINS=https://your-approved-client.example
# UIJEONG_ALLOW_LOCAL_ARCHIVE_HTTP=0
